# Als .env neben docker-compose.yml ablegen.

# Mit Caddy (HTTPS ohne weiteres Zutun): diese beiden Zeilen so lassen und die Domain eintragen. Sie muss
# per DNS auf diese Maschine zeigen, und die Ports 80 und 443 müssen frei und erreichbar sein.
# Mit nginx oder einem anderen Proxy auf dem Host: beide Zeilen auskommentieren. Der Server ist dann nur
# unter 127.0.0.1:8080 erreichbar, siehe deploy/nginx.conf.
COMPOSE_PROFILES=caddy
NEXA_DOMAIN=nexa.example.com

# Optional. NEXA_VERSION wählt das Image aus ghcr.io/qzconnor/nexa-server: latest (Stand von main),
# eine Version wie 0.1.0 oder einen Commit wie sha-1dc5d48. NEXA_LOCAL_PORT ist der Port auf 127.0.0.1,
# auf den ein Proxy auf dem Host zeigt.
# NEXA_VERSION=latest
# NEXA_LOCAL_PORT=8080
# TZ=Europe/Berlin
# NEXA_MAX_INSTANCES=20
# NEXA_MAX_MESSAGE_KB=1024
# NEXA_RATE_LIMIT=100
# NEXA_LOG_LEVEL=info

# Die Web-App fürs Handy unter https://<domain>/app/. Aus, weil der Server für sie nicht blind ist: Er
# liefert ihren Code, und sie hält den Schlüssel des Namespace. Siehe README, „Web-App“.
# NEXA_PWA=true
# Mit der Web-App kommt Push. Unter dieser Adresse erreichen die Push-Dienste den Betreiber.
# NEXA_VAPID_SUBJECT=mailto:admin@example.com

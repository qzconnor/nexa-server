{
  "name": "nexa-server",
  "version": "0.1.0",
  "private": true,
  "description": "Selbst gehosteter Server für Nexa: Remote Control und Abgleich zwischen den eigenen Geräten",
  "author": "Connor Breuer",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/main.ts serve",
    "dev:pwa": "vite --config pwa/vite.config.ts",
    "build:pwa": "vite build --config pwa/vite.config.ts",
    "sync:app": "node scripts/sync-from-app.ts",
    "cli": "node src/main.ts",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p pwa/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lucide/vue": "^1.81.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "markdown-it": "^15.0.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.3",
    "vue-tsc": "^3.3.14"
  }
}
